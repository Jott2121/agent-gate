description: Use when writing or changing README numbers, eval/benchmark code, experiment results, writeups, PR descriptions with metrics, or build-in-public post drafts
globs: "README.md,docs/**,eval/**,runs/**,reports/**,papers/**,WRITEUP.md,CHANGELOG.md"
alwaysApply: false
